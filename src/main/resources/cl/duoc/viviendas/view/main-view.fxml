<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.viviendas.controller.ViviendaController">
   <top>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblTitulo" text="Administradora de Viviendas" />
         </children>
         <padding>
            <Insets top="15.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <GridPane fx:id="gridFormulario" hgap="15.0" vgap="12.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints maxHeight="60.0" minHeight="0.0" prefHeight="29.0" vgrow="SOMETIMES" />
                  <RowConstraints maxHeight="60.0" minHeight="0.0" prefHeight="31.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Tipo de vivienda" />
                  <Label text="Código de propiedad" GridPane.rowIndex="1" />
                  <Label text="Superficie (m²)" GridPane.rowIndex="2" />
                  <Label text="Habitaciones" GridPane.rowIndex="3" />
                  <Label text="Número de piso" GridPane.rowIndex="4" />
                  <Label text="Gasto común al día" GridPane.rowIndex="5" />
                  <Label text="Estacionamiento asignado" GridPane.rowIndex="6" />
                  <Label text="Tiene patio" GridPane.rowIndex="7" />
                  <ComboBox fx:id="cmbTipo" onAction="#cambiarTipo" prefWidth="150.0" GridPane.columnIndex="1" />
                  <ComboBox fx:id="cmbPatio" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                  <ComboBox fx:id="cmbEstacionamiento" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                  <ComboBox fx:id="cmbGastoComun" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <TextField fx:id="txtSuperficie" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="txtHabitaciones" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <TextField fx:id="txtPiso" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
            <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#registrarVivienda" text="Registrar" />
            <TextField fx:id="txtBuscar" promptText="Buscar por código o tipo..." />
            <Label fx:id="lblTituloTabla" text="Viviendas registradas" />
            <TableView fx:id="tblViviendas" prefHeight="260.0" prefWidth="850.0">
              <columns>
                <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
                  <TableColumn fx:id="colSuperficie" prefWidth="107.0" text="Superficie (m²)" />
                  <TableColumn fx:id="colHabitaciones" prefWidth="103.0" text="Habitaciones" />
                  <TableColumn fx:id="colCostoArriendo" prefWidth="101.0" text="Costo arriendo" />
                <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Código" />
              </columns>
            </TableView>
            <HBox fx:id="hboxAcciones" prefHeight="100.0" prefWidth="200.0" spacing="12.0">
               <children>
                  <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarVivienda" text="Eliminar" />
                  <Label fx:id="lblMensaje" text="Aquí aparecerán los mensajes" wrapText="true" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
